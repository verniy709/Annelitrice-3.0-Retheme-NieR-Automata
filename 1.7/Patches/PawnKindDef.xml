<?xml version='1.0' encoding='utf-8'?>
<Patch>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/PawnKindDef[defName="Anneli_Larva"]/label</xpath>
    <value>
      <label>annelitrice stubby machine</label>
    </value>
  </Operation>
  <!-- Enlarge the larva graphic. -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/PawnKindDef[defName="Anneli_Larva"]/lifeStages/li/bodyGraphicData/drawSize</xpath>
    <value>
      <drawSize>1.25</drawSize>
    </value>
  </Operation>
  <!-- This retheme uses six machine-lifeform variants (0-5). Remove the 3 unused base variants. -->
  <Operation Class="PatchOperationRemove">
    <xpath>Defs/PawnKindDef[defName="Anneli_Larva"]/alternateGraphics/li[texPath="Anneli_Larva/Larva6"]</xpath>
  </Operation>
  <Operation Class="PatchOperationRemove">
    <xpath>Defs/PawnKindDef[defName="Anneli_Larva"]/alternateGraphics/li[texPath="Anneli_Larva/Larva7"]</xpath>
  </Operation>
  <Operation Class="PatchOperationRemove">
    <xpath>Defs/PawnKindDef[defName="Anneli_Larva"]/alternateGraphics/li[texPath="Anneli_Larva/Larva8"]</xpath>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/PawnKindDef[defName="Anneli_Larva"]/lifeStages/li/bodyGraphicData/texPath</xpath>
    <value>
      <texPath>Anneli_Retheme_NierAutomata/Anneli_Larva/Larva</texPath>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/PawnKindDef[defName="Anneli_Larva"]/lifeStages/li/dessicatedBodyGraphicData/texPath</xpath>
    <value>
      <texPath>Anneli_Retheme_NierAutomata/Anneli_Larva/Dessicated_Larva</texPath>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/PawnKindDef[defName="Anneli_Larva"]/alternateGraphics/li[texPath="Anneli_Larva/Larva1"]/texPath</xpath>
