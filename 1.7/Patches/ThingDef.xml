    <value>
      <texPath>Anneli_Retheme_NieRAutomata/Anneli_Item/Egg</texPath>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="Anneli_Pupa"]/graphicData/texPath</xpath>
    <value>
      <texPath>Anneli_Retheme_NieRAutomata/Anneli_Item/Pupa</texPath>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="AnnelitriceLarvaAsAnimal"]/statBases</xpath>
    <value>
      <MeatAmount>0</MeatAmount>
    </value>
  </Operation>
  <!-- Butchery yields Anneli_NutrientSolution -->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="AnnelitriceLarvaAsAnimal"]</xpath>
    <value>
      <butcherProducts>
        <Anneli_NutrientSolution>10</Anneli_NutrientSolution>
      </butcherProducts>
    </value>
  </Operation>
</Patch>