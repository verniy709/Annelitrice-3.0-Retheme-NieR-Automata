    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="Anneli_ColonistEgg"]/graphicData/texPath</xpath>
    <value>
      <texPath>Anneli_Retheme_NieRAutomata/Anneli_Item/Egg_Colonist</texPath>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
