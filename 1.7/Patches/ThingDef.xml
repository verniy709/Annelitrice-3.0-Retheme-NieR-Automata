    <xpath>Defs/ThingDef[defName="Anneli_Fountain"]/graphicData/texPath</xpath>
    <value>
      <texPath>Anneli_Retheme_NieRAutomata/Anneli_Building/Fountain</texPath>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
