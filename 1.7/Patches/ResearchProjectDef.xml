<?xml version='1.0' encoding='utf-8'?>
<Patch>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ResearchProjectDef[defName="Anneli_Fountain"]/label</xpath>
    <value>
      <label>annelitrice resource recovery unit</label>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ResearchProjectDef[defName="Anneli_Fountain"]/description</xpath>
    <value>
      <description>A reconstruction facility built with three processing systems: MEAT recovers usable matter, SOUL reads and preserves identity data, and GOD determines what form should be built.</description>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ResearchProjectDef[defName="Anneli_NutrientSolution"]/label</xpath>
